# ─── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────
# SQLite (default for local dev — file path)
DATABASE_URL=./data/influence.db

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

