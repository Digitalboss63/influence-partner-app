{
  "name": "influence-partner-app",
  "version": "0.1.0",
  "description": "AI-powered platform for discovering, recruiting, and managing influencer and affiliate partnerships.",
  "private": true,
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "db:seed": "tsx server/db/seed.ts",
    "db:setup": "npm run db:seed",
    "check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digitalboss63/influence-partner-app.git"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "sql.js": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/sql.js": "^1.4.9",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.21.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
